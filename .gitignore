# Images live in the working tree but never in history: 120MB+ of wallpapers
# and theme screenshots would bloat every clone forever. assets.txt records
# what is expected at each path.
themes/*/wallpapers/
themes/*/hyprlock/
themes/*/backgrounds/
themes/*/screenshots/
themes/*/preview.png


# Runtime state, not configuration
themes/current
modules/desktop/hypr/state/
modules/desktop/hypr/hyprmoncfg-monitors.lua

# Scratch
*.bak
*.bak.*
*~

# Generated by fcitx5
modules/desktop/fcitx5/conf/cached_layouts

# yamb runtime bookmarks
modules/cli/yazi/bookmark

# hyprmoncfg runtime state
modules/desktop/hyprmoncfg/display-fallbacks.json

# Working notes and AI memories stay local, never tracked
docs/

# Old macOS HISTFILE location, now a symlink into ~/.local/state
modules/shell/zsh/history
