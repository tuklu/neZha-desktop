#!/usr/bin/env python3
# The EC handles the keyboard backlight key itself and never emits a keypress.
# The driver signals the change via sysfs_notify on brightness_hw_changed, which
# only poll(POLLPRI) can observe (inotify does not fire on sysfs attributes).
import errno
import glob
import os
import select
import subprocess
import sys


def find_attribute() -> str | None:
    matches = glob.glob("/sys/class/leds/*kbd_backlight*/brightness_hw_changed")
    return matches[0] if matches else None


# The attribute reads ENODATA until the hardware has changed the brightness
# once since boot; that means "no value yet", not a failure.
def read_value(fd: int) -> str | None:
    os.lseek(fd, 0, os.SEEK_SET)
    try:
        return os.read(fd, 16).decode().strip()
    except OSError as e:
        if e.errno == errno.ENODATA:
            return None
        raise


def main() -> int:
    path = find_attribute()
    if path is None:
        print("no kbd_backlight brightness_hw_changed attribute", file=sys.stderr)
        return 1

    fd = os.open(path, os.O_RDONLY)
    poller = select.poll()
    poller.register(fd, select.POLLPRI | select.POLLERR)

    # sysfs requires one read before poll() blocks until the next notify.
    last = read_value(fd)
    while True:
        poller.poll()
        value = read_value(fd)
        if value != last:
            subprocess.run(["brightness-kbd", "show"], check=False)
            last = value


if __name__ == "__main__":
    sys.exit(main())
