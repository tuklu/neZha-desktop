#!/usr/bin/env bash
# Terminal screensaver — runs tte in a loop, exits on any input or focus loss.

screensaver_in_focus() {
    hyprctl activewindow -j | jq -e '.class == "org.nezha.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
    hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || \
        hyprctl keyword cursor:invisible false &>/dev/null || true
    pkill -x tte 2>/dev/null || true
    pkill -f 'class=org\.nezha\.screensaver' 2>/dev/null || true
    exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || \
    hyprctl keyword cursor:invisible true &>/dev/null || true

tty=$(tty 2>/dev/null)

while true; do
    tte -i ~/.config/neZha/screensaver.txt \
        --frame-rate 120 --canvas-width 0 --canvas-height 0 \
        --reuse-canvas --anchor-canvas c --anchor-text c \
        --random-effect --no-eol --no-restore-cursor &

    while pgrep -t "${tty#/dev/}" -x tte >/dev/null; do
        if read -n1 -t 1 || ! screensaver_in_focus; then
            exit_screensaver
        fi
    done
done
