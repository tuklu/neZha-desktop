[Unit]
Description=neZha keyboard backlight OSD (EC-handled key)
PartOf=graphical-session.target
After=graphical-session.target swayosd-server.service

[Service]
Type=simple
ExecStart=%h/.local/share/nezha/bin/kbd-backlight-watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
