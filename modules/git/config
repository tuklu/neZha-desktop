[init]
	defaultBranch = main
[pull]
	rebase = true
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

# Identity, signing and anything personal. install.sh writes a minimal one
# if nothing else provides it.
[include]
	path = ~/.config/git/local
