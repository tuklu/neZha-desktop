#!/usr/bin/env bash
# Blocks commits that add personal or secret-looking lines. Those belong in the
# private overlay. Override deliberately with: git commit --no-verify
set -euo pipefail

patterns=(
    '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
    '\b(10|127)\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b'
    '\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b'
    '\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}\b'
    '\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b'
    '/(home|Users)/[a-z][a-z0-9_-]*/'
    'op://'
    'BEGIN [A-Z ]*PRIVATE KEY'
    'gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}'
    'sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[abpr]-[A-Za-z0-9-]{10,}'
    'client[_-]secret'
)
allowed='noreply@|@example\.(com|org)|/home/user/|/Users/user/'

added=$(git diff --cached --no-color -U0 --diff-filter=AM | grep -E '^\+[^+]' || true)
[[ -z $added ]] && exit 0

hits=$(grep -nE "$(IFS='|'; echo "${patterns[*]}")" <<< "$added" | grep -vE "$allowed" || true)
if [[ -n $hits ]]; then
    echo "pre-commit: these added lines look personal or secret:" >&2
    echo "$hits" | cut -c1-160 >&2
    echo "move them to the private overlay, or commit with --no-verify if intended" >&2
    exit 1
fi
